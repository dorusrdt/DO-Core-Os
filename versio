// Zone Stack Structure (exactly like JS simulator)
struct ZoneSlot {
  int id;  // Array index (0-99)
  int physicalZoneNumber;  // Physical relay/zone number from server (1-100)
  bool configured;
  String zoneId;
  int waterPerDay;
  String irrigationTime;
  int humidityThreshold;
  // Sensors will be tracked in SENSOR_STACK
};

// Sensor Stack Structure (exactly like JS simulator)
struct SensorSlot {
  String id;
  bool assigned;
  String zoneId;
};

// Global Variables
ZoneSlot ZONE_STACK[MAX_ZONES]; // Dynamic zones based on config.h
SensorSlot SENSOR_STACK[MAX_SENSORS]; // Dynamic sensors based on config.h
String assignedZones[MAX_ZONES]; // Track assigned zone IDs
int assignedZoneCount = 0;

unsigned long lastConfigPoll = 0;
unsigned long lastSensorRead = 0;
unsigned long lastDataSend = 0;
bool deviceRegistered = false;
bool deviceAssigned = false;
bool wifiConnected = false;

// Global sensor data for environmental conditions
float globalTemperature = 24.5;
float globalHumidity = 60.0;
float globalPressure = 1012.0;

// Simulation Variables
float simulatedMoisture[MAX_SENSORS];
bool pumpRunning = false;

// Irrigation Control Variables
bool isIrrigating = false;
unsigned long activeIrrigationTimer = 0;
const int PUMP_PIN = 2; // GPIO pin for pump control

void setup() {
  Serial.begin(115200);
  delay(1000); // Give serial time to initialize

  Serial.println("\n🚀 ESP32 Irrigation Device Simulator v2.0...");
  Serial.printf("📱 Device ID: %s\n", DEVICE_ID);
  Serial.println("===========================================\n");

  // Initialize zone stack (dynamic based on MAX_ZONES)
  for (int i = 0; i < MAX_ZONES; i++) {
    ZONE_STACK[i].id = i + 1;
    ZONE_STACK[i].configured = false;
    ZONE_STACK[i].zoneId = "";
    ZONE_STACK[i].waterPerDay = 0;
    ZONE_STACK[i].irrigationTime = "";
    ZONE_STACK[i].humidityThreshold = 0;
  }

  // Initialize sensor stack (dynamic based on MAX_SENSORS)
  for (int i = 0; i < MAX_SENSORS; i++) {
    // Generate sensor IDs: s01-s99 (2 digits), s100-s999 (3 digits)
    if (i < 9) {
      SENSOR_STACK[i].id = "s0" + String(i + 1);
    } else if (i < 99) {
      SENSOR_STACK[i].id = "s" + String(i + 1);
    } else {
      SENSOR_STACK[i].id = "s" + String(i + 1);
    }
    SENSOR_STACK[i].assigned = false;
    SENSOR_STACK[i].zoneId = "";
  }

  // Initialize hardware
  initializeHardware();

  // Connect to WiFi
  connectToWiFi();

  if (wifiConnected) {
    // Initialize time (needed for getLocalTime)
    Serial.println("⏰ Configuring NTP time...");
    configTime(0, 0, "pool.ntp.org", "time.nist.gov");

    // Protocol 1: Register device with server
    registerDevice();

    if (deviceRegistered) {
      Serial.println("⏳ Device registered. Checking for existing assignments...");
    }
  }

  // Initialize sensor simulation
  for (int i = 0; i < MAX_SENSORS; i++) {
    simulatedMoisture[i] = 30 + random(0, 30); // 30-60% initial moisture
  }

  Serial.println("✅ ESP32 Irrigation System Ready!");
  Serial.println("===========================================\n");
}

void loop() {
  unsigned long currentTime = millis();

  // Check WiFi connection
  if (WiFi.status() != WL_CONNECTED) {
    reconnectWiFi();
    return;
  }

  // Check irrigation timer
  checkIrrigationTimer();

  // Poll configuration every 10 seconds
  if (currentTime - lastConfigPoll >= 10000) {
    pollConfiguration();
    lastConfigPoll = currentTime;
  }

  // Read sensors every 5 seconds
  if (currentTime - lastSensorRead >= 5000) {
    readAllSensors();
    lastSensorRead = currentTime;
  }

  // Send sensor data every 15 seconds
  if (currentTime - lastDataSend >= 15000) {
    sendSensorData();
    lastDataSend = currentTime;
  }

  // Check irrigation schedule every minute
  if (currentTime % 60000 < 1000) {
    checkIrrigationSchedule();
  }

  // Check moisture thresholds every 30 seconds
  if (currentTime % 30000 < 1000) {
    checkMoistureThresholds();
  }

  delay(1000); // 1 second delay
}

